# Motor de IA: claude-cli (usa a assinatura do Claude via Claude Code, sem créditos) | api (créditos pagos)
LLM_PROVIDER=claude-cli
# Opcional: caminho do binário do Claude Code (padrão: versão mais nova encontrada)
CLAUDE_CLI_PATH=
# Só para LLM_PROVIDER=api
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-5-5
LIGHT_MODEL=claude-haiku-4-5

USD_BRL=5.40
DATABASE_PATH=data/app.db
# Opcional, para banco hospedado (Turso): DATABASE_URL=libsql://… e DATABASE_AUTH_TOKEN=…
MASK_PII=false
NOTIFY_DRY_RUN=true
# Links nas mensagens (alertas e relatório diário)
PANEL_URL=http://localhost:3000
# Só com NOTIFY_DRY_RUN=false
SLACK_WEBHOOK_URL=

# ---- Versão publicada (Vercel) ----
# Login do painel publicado (defina só na Vercel; vazio = sem login, uso local)
SITE_LOGIN=
SITE_PASSWORD=
# true = ninguém altera dados pelo painel (versão de validação)
READ_ONLY=
# Vídeos: segredo dos nomes dos arquivos (gere um valor aleatório; o mesmo no PC e na Vercel)
MEDIA_KEY_SALT=
# blob = vídeos privados no Vercel Blob com link que expira (só na Vercel); vazio = arquivo local
MEDIA_STORAGE=
# Token do Vercel Blob (para pnpm media:upload no PC; na Vercel ele vem sozinho ao ligar o store)
BLOB_READ_WRITE_TOKEN=

# MakeCRM: chave da API de reuniões (Configurações › Empresa › Chaves de API). Só no servidor.
MAKECRM_API_KEY=
